# Copy this file to scripts/.env and fill in the values.
# Source it before running: source scripts/.env

# Target GitHub repository (owner/repo)
export GITHUB_REPO=myorg/myrepo

# Secret shared between GitHub and the Ballerina service for HMAC validation
export WEBHOOK_SECRET=replace-with-a-strong-random-secret

# Optional overrides
# export LISTENER_PORT=8090
# export EVENT_WAIT_SECS=20
